# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime output: every `agentic-sdlc run` writes a timestamped run folder here.
# It is regenerated on demand, so it is not committed.
runs/

# Editor noise
.vscode/
.idea/
*.swp
.DS_Store

# Secrets — never commit API keys or local env files
.env
.env.*
*.key
secrets.*
